{
	auto_https off
	admin off
}

http://embed.localhost {
	handle /api/git/branch/switch {
		reverse_proxy host.docker.internal:3001
	}
	handle /api/dev/restart-status {
		reverse_proxy host.docker.internal:3001
	}

	handle /api/* {
		reverse_proxy host.docker.internal:3000
	}

	handle {
		reverse_proxy host.docker.internal:5173
	}
}

http://host.localhost {
	root * /srv/embed-host
	file_server
}
