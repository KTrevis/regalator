{
  "name": "@regalator/back",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./type": {
      "types": "./dist/api-types.d.ts",
      "default": "./dist/empty.js"
    }
  },
  "files": [
    "dist/api-types.d.ts",
    "dist/app.d.ts",
    "dist/empty.js"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && bun build src/index.ts src/empty.ts --target=bun --outdir=dist --external @regalator/shared",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@elysiajs/cors": "^1.4.0",
    "@notionhq/client": "^5.26.0",
    "@prisma/adapter-libsql": "7.8.0",
    "@prisma/client": "7.8.0",
    "@regalator/shared": "workspace:*",
    "elysia": "^1.4.18",
    "isomorphic-git": "^1.41.9",
    "notion-to-md": "^3.1.9"
  },
  "devDependencies": {
    "@regalator/typescript-config": "workspace:*",
    "bun-types": "latest",
    "prisma": "7.8.0"
  }
}
