{
  "name": "@remote-kanban/back",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./type": {
      "types": "./dist/api-types.d.ts",
      "default": "./dist/empty.js"
    }
  },
  "files": ["dist/api-types.d.ts", "dist/app.d.ts", "dist/empty.js"],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && bun build src/index.ts src/empty.ts --target=bun --outdir=dist --external @remote-kanban/shared",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@remote-kanban/shared": "workspace:*",
    "elysia": "^1.4.18",
    "isomorphic-git": "^1.41.9"
  },
  "devDependencies": {
    "@remote-kanban/typescript-config": "workspace:*",
    "bun-types": "latest"
  }
}
