# Absolute path to the managed project repository.
REMOTE_KANBAN_PROJECT_PATH=/absolute/path/to/project

# Paths are relative to REMOTE_KANBAN_PROJECT_PATH.
REMOTE_KANBAN_CHECKOUT_HOOK=scripts/remote-kanban-checkout.sh
REMOTE_KANBAN_START_SCRIPT=scripts/remote-kanban-start.sh

# Optional direct backend URL. Any HTTP response means the project is ready.
REMOTE_KANBAN_BACKEND_URL=http://127.0.0.1:8080

# Optional. Defaults to <REMOTE_KANBAN_PROJECT_PATH>-worktrees.
# REMOTE_KANBAN_WORKTREES_PATH=/absolute/path/to/project-worktrees

# Optional Caddy port. Defaults to 80.
# CADDY_HTTP_PORT=8080
