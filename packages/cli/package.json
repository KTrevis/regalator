{
  "name": "@regalator/cli",
  "version": "0.1.0",
  "description": "Install and run Regalator for a Git project",
  "type": "module",
  "bin": {
    "regalator": "dist/bin/regalator.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build.ts",
    "check-types": "tsc --noEmit",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@libsql/client": "0.17.4",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@regalator/back": "workspace:*",
    "@regalator/front": "workspace:*",
    "@regalator/shared": "workspace:*",
    "@regalator/typescript-config": "workspace:*",
    "bun-types": "latest"
  },
  "engines": {
    "bun": ">=1.3.5"
  }
}
