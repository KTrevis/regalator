{
  "name": "remote-kanban",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose -f compose.dev.yml up -d caddy && turbo run dev",
    "dev:apps": "turbo run dev",
    "dev:proxy": "docker compose -f compose.dev.yml up -d caddy",
    "dev:down": "docker compose -f compose.dev.yml down",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.5"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
